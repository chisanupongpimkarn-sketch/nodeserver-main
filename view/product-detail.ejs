<main class="py-5">
	<div class="container">
		<% if (typeof product === 'undefined' || !product) { %>
			<div class="alert alert-warning text-center py-5 rounded-4 shadow-sm">
				<h2 class="h4 mb-3">ไม่พบสินค้าที่ต้องการ</h2>
				<p class="text-secondary mb-4">รหัสสินค้าที่คุณค้นหาอาจไม่มีอยู่จริงหรือถูกย้ายแล้ว</p>
				<div class="d-flex justify-content-center gap-2">
					<a href="/product" class="btn btn-amber rounded-pill px-4">ไปหน้าสินค้าแนะนำ</a>
					<a href="/showProduct" class="btn btn-outline-dark rounded-pill px-4">ดูอุปกรณ์เครือข่าย</a>
				</div>
			</div>
		<% } else { %>
			<div class="mb-4 d-flex flex-wrap gap-2 align-items-center">
				<a class="btn btn-sm btn-outline-dark rounded-pill px-3" href="/product">← กลับไปหน้าสินค้าแนะนำ</a>
				<a class="btn btn-sm btn-outline-secondary rounded-pill px-3" href="/showProduct">ดูอุปกรณ์เครือข่าย</a>
				<a class="btn btn-sm btn-link text-decoration-none text-muted" href="/">หน้าแรก</a>
			</div>
			<div class="row g-4 align-items-center bg-white p-4 p-md-5 rounded-4 shadow-sm border">
				<div class="col-md-6 text-center">
					<img class="img-fluid rounded-4" style="max-height: 380px; object-fit: contain; width: 100%; background: #f8f8f7; padding: 1.5rem;" src="<%= product.image %>" alt="<%= product.alt || product.name %>">
				</div>
				<div class="col-md-6">
					<div class="d-flex flex-wrap gap-2 mb-3">
						<% if (product.label) { %>
							<span class="badge text-bg-warning px-3 py-2"><%= product.label %></span>
						<% } %>
						<span class="badge text-bg-light border px-3 py-2 text-secondary">รหัสสินค้า: <%= product.id %></span>
					</div>
					<h1 class="h2 fw-semibold mb-3"><%= product.name %></h1>
					<p class="text-secondary mb-3 fs-5 lh-base"><%= product.description %></p>
					
					<div class="price mb-3 fs-3">
						<%= product.price %>
						<% if (product.oldPrice) { %>
							<span class="old-price ms-2 fs-5"><%= product.oldPrice %></span>
						<% } %>
					</div>

					<% if (typeof product.quantity !== 'undefined') { %>
						<div class="mb-4 p-3 bg-light rounded-3">
							<strong class="d-block mb-1">สถานะสินค้าคงคลัง:</strong>
							<% if (product.quantity > 0) { %>
								<span class="text-success fw-medium">✓ มีสินค้าพร้อมส่ง (<%= product.quantity %> ชิ้น)</span>
							<% } else { %>
								<span class="text-danger fw-medium">✗ สินค้าหมดชั่วคราว (Out of Stock)</span>
							<% } %>
						</div>
					<% } %>

					<div class="d-flex flex-wrap gap-2 mt-4">
						<a href="/#contact" class="btn btn-amber rounded-pill px-4 py-2">สอบถาม / สั่งซื้อสินค้า</a>
						<a href="/product" class="btn btn-outline-dark rounded-pill px-4 py-2">เลือกดูสินค้าอื่น</a>
					</div>
				</div>
			</div>
		<% } %>
	</div>
</main>
