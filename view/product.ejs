<main class="py-5" id="products">
	<div class="container">
		<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-4">
			<div>
				<p class="section-label mb-1">คัดสรรเพื่อคุณ</p>
				<h1 class="h2 fw-semibold mb-0">สินค้าแนะนำ</h1>
			</div>
			<div class="d-flex gap-2">
				<a class="btn btn-outline-dark rounded-pill px-3" href="/showProduct">ดูอุปกรณ์เครือข่ายทั้งหมด</a>
				<a class="btn btn-amber rounded-pill px-3" href="/">กลับหน้าแรก <span aria-hidden="true">→</span></a>
			</div>
		</div>
		<div class="row g-4">
			<% products.forEach(product => { %>
				<div class="col-6 col-lg-3">
					<article class="product-card h-100 overflow-hidden d-flex flex-column">
						<a href="/product/<%= product.id %>" aria-label="ดูสินค้า <%= product.name %>">
							<img class="product-image w-100" src="<%= product.image %>" alt="<%= product.alt %>">
						</a>
						<div class="p-3 d-flex flex-column flex-grow-1">
							<span class="badge text-bg-warning mb-2 align-self-start"><%= product.label %></span>
							<h2 class="h6 flex-grow-1">
								<a class="text-decoration-none text-dark" href="/product/<%= product.id %>"><%= product.name %></a>
							</h2>
							<div class="price my-2">
								<%= product.price %><% if (product.oldPrice) { %> <span class="old-price ms-1"><%= product.oldPrice %></span><% } %>
							</div>
							<a href="/product/<%= product.id %>" class="btn btn-outline-dark btn-sm rounded-pill mt-auto w-100">ดูสินค้า</a>
						</div>
					</article>
				</div>
			<% }); %>
		</div>
	</div>
</main>